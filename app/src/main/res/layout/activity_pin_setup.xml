<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:maxWidth="480dp"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set a parent PIN"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="This PIN unlocks the parent menu. To open it, tap the bottom-left corner of the screen 4 times quickly." />

        <EditText
            android:id="@+id/pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="New PIN (4 to 8 digits)"
            android:importantForAutofill="no"
            android:inputType="numberPassword"
            android:maxLength="8" />

        <EditText
            android:id="@+id/confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Confirm PIN"
            android:importantForAutofill="no"
            android:imeOptions="actionDone"
            android:inputType="numberPassword"
            android:maxLength="8" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#C62828"
            android:visibility="gone" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Save PIN" />

        <!-- First-run step (Android 11+): full-screen screenshots. Shown in place of the PIN fields. -->
        <LinearLayout
            android:id="@+id/shot_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/shot_restricted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="If the switch is greyed out (Restricted setting): open Settings › Apps › Little Explorer (App info), tap ⋮ › Allow restricted settings, then turn it on."
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:visibility="gone" />

            <Button
                android:id="@+id/shot_on"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Turn on" />

            <Button
                android:id="@+id/shot_skip"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Skip for now" />
        </LinearLayout>

        <TextView
            android:id="@+id/owner_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Heads up: this app is not the device owner yet, so the device will not be locked down. See the install guide."
            android:textColor="#E65100"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
